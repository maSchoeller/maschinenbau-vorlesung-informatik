---
/* Durchreich-Route für die Werkzeugseiten (Klausurtrainer und Probeklausur entfernt, 2026-11-25) der Wurzel */
import Durchreichen from '../layouts/Durchreichen.astro';
export function getStaticPaths() {
  return ['bibliothek', 'pap-editor']
    .map((s) => ({ params: { seite: s }, props: { datei: s + '.html' } }));
}
const { datei } = Astro.props;
---
<Durchreichen datei={datei} />
