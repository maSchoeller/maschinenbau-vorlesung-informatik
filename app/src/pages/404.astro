---
/* Fehlerseite (staticwebapp.config.json: responseOverrides 404). Gehört dem Fundament. */
import App from '../layouts/App.astro';
---
<App pfad="404.html" art="404" titel="Seite nicht gefunden">
  <main id="inhalt" class="app-seite">
    <h1>Seite nicht gefunden</h1>
    <p>Diese Adresse gibt es nicht (mehr). Über die Leiste links kommst du zurück zu Heute, zum Kurs oder zur Bibliothek.</p>
    <p><a class="k-btn" href="/index.html">Zu Heute</a></p>
  </main>
</App>
