---
/* Durchreich-Route für alle Lerneinheiten und Labore aus kurs.yaml */
import Durchreichen from '../../layouts/Durchreichen.astro';
import { ladeKurs } from '../../lib/kurs.mjs';
export function getStaticPaths() {
  const dateien = ladeKurs().lektionen.flatMap((t) => [t.lerneinheit, t.labor]).filter(Boolean);
  return dateien.map((d) => ({ params: { seite: d.replace(/\.html$/, '') }, props: { datei: 'lektionen/' + d } }));
}
const { datei } = Astro.props;
---
<Durchreichen datei={datei} />
