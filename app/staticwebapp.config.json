{
  "platform": { "apiRuntime": "node:22" },
  "routes": [
    { "route": "/.auth/login/aad", "statusCode": 404 },
    { "route": "/.auth/login/aad/*", "statusCode": 404 },
    { "route": "/login", "redirect": "/.auth/login/github", "statusCode": 302 },
    { "route": "/logout", "redirect": "/.auth/logout", "statusCode": 302 },
    { "route": "/sw.js", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/app/daten/*", "headers": { "Cache-Control": "no-cache" } },
    { "route": "/app/*.{js,css}", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
    { "route": "/pyodide/*", "headers": { "Cache-Control": "public, max-age=86400" } }
  ],
  "responseOverrides": {
    "404": { "rewrite": "/404.html" }
  },
  "globalHeaders": {
    "Cache-Control": "no-cache",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self' blob: https://*.blob.core.windows.net; connect-src 'self' https://*.blob.core.windows.net; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
  },
  "mimeTypes": {
    ".wasm": "application/wasm",
    ".webmanifest": "application/manifest+json",
    ".whl": "application/zip",
    ".zip": "application/zip",
    ".vtt": "text/vtt",
    ".mp4": "video/mp4",
    ".py": "text/plain; charset=utf-8",
    ".ipynb": "application/x-ipynb+json",
    ".json": "application/json"
  }
}
